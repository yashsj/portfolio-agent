# Copy this file to .env.local and fill in real values. Nothing here is a
# secret — this file is committed; .env.local is gitignored and never should
# be. In production (Vercel), set these in the project's Environment
# Variables settings instead of relying on .env.local.

# ── Database (Neon Postgres) — required ─────────────────────────────────────
# Used by every api/*.js file that touches the DB (rate limiting, daily cap,
# bookings, leads). Free tier: https://neon.tech — or provision via Vercel's
# own Postgres integration, which sets this for you automatically in
# production (you'd still need it locally for `vercel dev`).
POSTGRES_URL=

# ── Gemini API — required, used by api/ask.js (the conversational agent) ───
# Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Everything below is optional — the agent degrades gracefully without it
# (see api/_features.js: an unconfigured feature is simply never offered to
# a visitor, not offered-and-then-failing).

# ── Google Cloud Text-to-Speech — used by api/speak.js (voice replies) ─────
# Needs a GCP project with the Cloud Text-to-Speech API enabled:
# https://console.cloud.google.com/apis/library/texttospeech.googleapis.com
GOOGLE_TTS_API_KEY=

# ── Google Calendar OAuth — used by api/_calendar.js ────────────────────────
# (real-time availability, booking, cancel/reschedule). Full setup walkthrough
# in docs/CALENDAR_OAUTH_SETUP.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# ── Resend — used by api/_email.js ──────────────────────────────────────────
# (leave_message notifications, meeting reminders, AND the confirmation
# codes cancel_meeting/reschedule_meeting email before acting — see
# api/_bookingConfirm.js). Free tier, no OAuth. Get a key:
# https://resend.com/api-keys
# Without both set, leave_message AND cancel/reschedule are auto-disabled
# the same way scheduling is above — not offered to the agent at all.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Cron authentication — optional, used by api/cron-reminders.js ──────────
# Verifies the reminder cron endpoint is actually being called by Vercel's
# own scheduler, not just anyone hitting the URL. Vercel automatically sends
# this as a Bearer token on scheduled requests when it's set. Generate any
# random string, e.g.: openssl rand -hex 32
# Without it, the endpoint accepts any caller — set this before relying on
# reminders for anything real.
CRON_SECRET=
